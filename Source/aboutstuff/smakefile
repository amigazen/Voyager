# AmiTLS-style 68k link for voyager_about.vlib
# From Source/aboutstuff: smake  then  smake install
#
# $Id: smakefile,v 1.7 2001/06/04 21:15:12 owagner Exp $
#

CC = sc
OBJS = about.o v3logo.o
FD = fd/v_about_lib.fd

all: voyager_about.vlib

voyager_about.vlib: $(OBJS)
	slink FROM lib:libent.o,lib:libinit.o $(OBJS) LIB lib:sc.lib LIB lib:amiga.lib \
	SMALLCODE SMALLDATA ADDSYM NOICONS \
	LIBVERSION 4 LIBREVISION 5 \
	LIBFD $(FD) \
	LIBID about_vlib \
	to voyager_about.vlib.debug
	slink FROM lib:libent.o,lib:libinit.o $(OBJS) LIB lib:sc.lib LIB lib:amiga.lib \
	SMALLCODE ND SMALLDATA NOICONS \
	LIBVERSION 4 LIBREVISION 5 \
	LIBFD $(FD) \
	LIBID about_vlib \
	to voyager_about.vlib

about.o: about.c
	$(CC) about.c to about.o

v3logo.o: /v3logo.c
	$(CC) /v3logo.c OBJECTNAME=v3logo.o

clean:
	-delete \#?.(o|map|lnk)
	-delete voyager_about.vlib voyager_about.vlib.debug QUIET

install: all
	copy voyager_about.vlib to //Internet/Voyager/Plugins
	-avail flush
