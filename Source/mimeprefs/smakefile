# SMakefile for MimePrefs
#
# SAS/C smake counterpart of makefile
#

# Objects
OBJ = mimeprefs.o loadvprefs.o mimeprefs_cat.o vat_sup.o vatstatic.o

MimePrefs: $(OBJ)
	slink from lib:c.o $(OBJ) to mimeprefs.debug noicons addsym sc sd \
	with lib:utillib.with lib lib:sc.lib,lib:small.lib,lib:debug.lib \
	map mp.map hsflxo swidth 32 noicons
	slink mimeprefs.debug to MimePrefs stripdebug

mimeprefs.gst: gst.h
	gst unload mimeprefs.gst
	sc makegst=mimeprefs.gst gst.c

mimeprefs_cat.o: mimeprefs.cd mimeprefs_cat.h
	catcomp mimeprefs.cd cfile mimeprefs_cat.h objfile mimeprefs_cat.o
# Original catmaker-based build (commented out):
#mimeprefs_cat.o: mimeprefs.cd
#	catmaker mimeprefs.cd mimeprefs_cat.h
#	asm -omimeprefs_cat.o t:cattmp.a
#	delete t:cattmp.a

loadvprefs.o: loadvprefs.c
	sc DEF=AMIGAOS CODE=FAR CPU=68020 MATH=IEEE loadvprefs.c

vat_sup.o: /vat/sup_generic.c
	sc DEF=AMIGAOS DEF=NO_VAT_SHORTCUTS CODE=FAR CPU=68020 MATH=IEEE OBJNAME=vat_sup.o /vat/sup_generic.c

vatstatic.o: vatstatic.c vatstatic.h mui.h
	sc DEF=AMIGAOS CODE=FAR CPU=68020 MATH=IEEE NOGST vatstatic.c

mimeprefs.o: mimeprefs.c mimeprefs.h mimeprefs.gst mimeprefs_cat.o
	sc DEF=AMIGAOS CODE=FAR IGN=72 CPU=68020 MATH=IEEE mimeprefs.c

install:
	-copy MimePrefs //Internet/Voyager/MimePrefs

clean:
	-delete \#?.(o|map|lnk)
	-delete MimePrefs
	-delete mimeprefs.debug
	-delete mimeprefs.gst
